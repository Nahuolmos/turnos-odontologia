# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/turnos_odontologia

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_MIN=30

# Timezone
TZ_CLINICA=America/Argentina/Buenos_Aires

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TTL_MIN=30

# Twilio WhatsApp
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=

# Google Calendar
GCAL_CALENDAR_ID=

# SMTP (fallback for email)
SMTP_URL=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO